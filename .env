# =============================================================================
# SuperGrok Bot RDP Edition - Konfigurasi Lingkungan (.env)
# File ini berisi data sensitif. JANGAN diunggah ke GitHub atau repositori publik.
# =============================================================================

# API Key Groq Cloud (dapatkan di https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Model Groq yang digunakan sebagai otak analis teks
GROQ_MODEL=llama3-8b-8192

# Daftar simbol crypto yang dipantau (dipisahkan koma)
CRYPTO_SYMBOLS=BTC-USD,ETH-USD,SOL-USD

# Saldo virtual awal untuk simulasi Paper Trading (USD)
INITIAL_VIRTUAL_BALANCE=10000

# Interval pemindaian otomatis bot dalam detik (default 300 = 5 menit)
SCAN_INTERVAL_SECONDS=300

# Jeda antara panggilan Groq API untuk menghindari rate-limit paket gratis (detik)
GROQ_SLEEP_SECONDS=2

# Window periode untuk indikator SMA (Simple Moving Average)
SMA_WINDOW=20

# =============================================================================
# KONFIGURASI TRADING (PAPER vs REAL)
# =============================================================================

# Mode trading: "PAPER" (simulasi aman) atau "REAL" (uang asli - BERESICO TINGGI)
# Default selalu PAPER. JANGAN ganti ke REAL kecuali sudah paham risiko sepenuhnya.
TRADING_MODE=PAPER

# Persentase trailing stop (contoh 0.05 = 5% dari harga puncak setelah entry)
TRAILING_STOP_PERCENT=0.05

# Jumlah USD per order (paper atau real)
TRADE_AMOUNT_USD=100

# =============================================================================
# OPSIONAL: X (Twitter) API v2 - Untuk mencari berita/komunitas viral nyata
# Groq TIDAK bisa langsung mencari di X. Kamu butuh X API v2 Bearer Token terlebih dahulu.
# Dapatkan di https://developer.twitter.com
# =============================================================================

X_API_BEARER_TOKEN=your_x_api_bearer_token_here
X_SEARCH_QUERY=BTC OR ETH OR SOL OR memecoin OR crypto
X_MAX_RESULTS=10

# =============================================================================
# OPSIONAL: Exchange API untuk REAL TRADING (CCXT) - HANYA jika TRADING_MODE=REAL
# Contoh Binance. ISI API KEY DAN SECRET ANDA. JANGAN bagikan ke siapa pun.
# =============================================================================

EXCHANGE_ID=binance
EXCHANGE_API_KEY=your_exchange_api_key
EXCHANGE_API_SECRET=your_exchange_api_secret
EXCHANGE_SANDBOX=True  # Gunakan True untuk testnet dulu sebelum real

# OPSIONAL: DEX / Wallet Private Key (Solana/Ethereum) untuk memecoin di DEX
# DEX_PRIVATE_KEY=your_private_key_here
# DEX_RPC_URL=https://api.mainnet-beta.solana.com
